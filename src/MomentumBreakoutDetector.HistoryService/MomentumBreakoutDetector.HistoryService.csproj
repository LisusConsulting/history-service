<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MomentumBreakoutDetector.HistoryService</RootNamespace>
    <UserSecretsId>mbd-history-service</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Phase E — expose internal helpers (ConcurrencyLimitingHandler.ResetGateForTests)
         to the test assembly so the ConcurrencyLimitingHandlerTests can reset
         the static gate to a known cap without polluting the production API. -->
    <InternalsVisibleTo Include="MomentumBreakoutDetector.HistoryService.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" />
    <PackageReference Include="Grpc.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Google.Protobuf" />

    <PackageReference Include="Npgsql" />
    <PackageReference Include="Dapper" />

    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />

    <!-- Alpaca SDK — REST data client for stock bars (Phase 2c). -->
    <PackageReference Include="Alpaca.Markets" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />

    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Server + Client proto generation. The Contracts project keeps
         GrpcServices="Client" so external NuGet consumers get the lean
         client-only surface. The service project itself emits Both so
         internal tooling that ProjectReferences the service (seeder,
         tests) can drive the gRPC server with a real client without
         needing a separate Contracts ref (which would CS0433 on every
         proto-generated type).

         Originally Server-only, switched to Both during the gap-detection
         rework when the seeder gained a ProjectReference to the service
         project to share TradingCalendar (Domain). -->
    <Protobuf Include="..\MomentumBreakoutDetector.HistoryService.Contracts\Protos\history.proto"
              GrpcServices="Both"
              Link="Protos/history.proto" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase E: source-level reference to the polygon-net-client SDK
         (0.10.0). Replaces the published TreyThomasCodes.Polygon.Models /
         RestClient NuGets so we can use the new pluggable handler chain
         (AddPolygonClient(o, builder => ...)) and the Raw ApiResponse
         variants exposed for body-level inspection of Polygon's
         "200 + status:ERROR" quirk. Pin: 614a273. -->
    <ProjectReference Include="..\..\external\polygon-net-client\TreyThomasCodes.Polygon.Models\TreyThomasCodes.Polygon.Models.csproj" />
    <ProjectReference Include="..\..\external\polygon-net-client\TreyThomasCodes.Polygon.RestClient\TreyThomasCodes.Polygon.RestClient.csproj" />
  </ItemGroup>

</Project>
