<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>MomentumBreakoutDetector.HistoryService.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <!-- PR 3 — FakeTimeProvider for the daily-flow refresh cron tests. -->
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />
    <!-- micro-PR #2 (bars) + #3 (NBBO) — Testcontainers tests apply
         schema inline (rather than mounting migration .sql files) so
         the test stays hermetic. Dapper for the helpers and Npgsql for
         the testcontainer connection. -->
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Dapper" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Service project re-emits the proto with GrpcServices="Server"
         (which includes message types). Referencing the Contracts project
         here too would pull in a second copy of every message type under
         the same namespace, tripping CS0433. The Service project is the
         single source of truth for proto types in tests. -->
    <ProjectReference Include="..\..\src\MomentumBreakoutDetector.HistoryService\MomentumBreakoutDetector.HistoryService.csproj" />
    <!-- PR 2 — DailyOptionsFlowSeederTests exercises DailyOptionsFlowSeederEngine
         + SeedOptions + Surface enum + Checkpoint, which all live in the
         seeder tooling project. The seeder project transitively references
         the service project so this does not double-link proto types. -->
    <ProjectReference Include="..\..\tools\seed\MomentumBreakoutDetector.HistoryService.Seeder\MomentumBreakoutDetector.HistoryService.Seeder.csproj" />
    <!-- PR 9 — pin the bootstrap-import filter predicate. -->
    <ProjectReference Include="..\..\tools\import-mbd-snapshots\MomentumBreakoutDetector.HistoryService.ImportMbdSnapshots.csproj" />
  </ItemGroup>

</Project>
