# mbd-history operator environment template.
#
# Copy to .env at repo root and fill in real values. .env is gitignored.
# docker compose automatically loads .env from the same directory as
# docker-compose.yml, so values defined here are interpolated into the
# compose file's ${VAR:-} placeholders.

# ----------------------------------------------------------------------
# Upstream data provider keys.
# ----------------------------------------------------------------------

# Polygon REST API key. Required for live bars / NBBO / chains fetches.
# Without it, the fetcher fail-quiets on 401/403 and surfaces zero-row
# responses + warn logs (no hard crash).
POLYGON_API_KEY=

# FRED API key. Required for macro series fetches (VIXCLS, DGS10, etc.).
# Same fail-quiet contract as Polygon.
FRED_API_KEY=

# ----------------------------------------------------------------------
# Phase 2 auth (not yet enforced — pre-wired for the cutover).
# ----------------------------------------------------------------------

# M2M client_credentials secret used to mint tokens at
# https://sts.motuzko.com/connect/token (client: mbd-api-tools).
# Phase 2 will require Bearer auth on the gRPC surface; until then this
# is unused but pre-wired into compose so the cutover is a no-deploy
# config flip.
MBD_API_TOOLS_SECRET=

# ----------------------------------------------------------------------
# Build metadata (optional — populated by tools/build.{sh,ps1}).
# ----------------------------------------------------------------------

GIT_COMMIT=unknown
GIT_BRANCH=unknown
BUILD_TIME=unknown
