<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MomentumBreakoutDetector.HistoryService.Seeder</RootNamespace>
    <AssemblyName>MomentumBreakoutDetector.HistoryService.Seeder</AssemblyName>
    <!-- Tooling project — never published, never packed. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- TradingCalendar (Domain) lives in the main service project after
         the gap-detection rework. The seeder uses the same calendar to
         enumerate trading days + half-days. Keeping a single source of
         truth across the seeder + providers avoids the holiday-list
         drift bug-class.
         Referencing the service project also pulls in the generated gRPC
         types (the server-side Protobuf re-emit covers the Client surface
         too), so we DON'T also reference the Contracts project — that
         would surface CS0433 ambiguity on every proto-generated type. -->
    <ProjectReference Include="..\..\..\src\MomentumBreakoutDetector.HistoryService\MomentumBreakoutDetector.HistoryService.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Match transport package versions to the contracts assembly so the
         runtime resolves a single Grpc.Net.Client. -->
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Google.Protobuf" />
  </ItemGroup>

</Project>
