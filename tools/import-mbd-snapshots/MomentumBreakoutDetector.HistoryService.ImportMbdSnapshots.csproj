<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MomentumBreakoutDetector.HistoryService.ImportMbdSnapshots</RootNamespace>
    <AssemblyName>MomentumBreakoutDetector.HistoryService.ImportMbdSnapshots</AssemblyName>
    <!-- One-shot operator tool — never published, never packed. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Expose the FilterPredicate to the test assembly so the filter
         logic can be pinned without spinning up two postgres containers. -->
    <InternalsVisibleTo Include="MomentumBreakoutDetector.HistoryService.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

</Project>
