<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- gRPC -->
    <PackageVersion Include="Google.Protobuf" Version="3.33.5" />
    <PackageVersion Include="Grpc.AspNetCore" Version="2.76.0" />
    <PackageVersion Include="Grpc.AspNetCore.Server.Reflection" Version="2.76.0" />
    <PackageVersion Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageVersion Include="Grpc.Tools" Version="2.78.0" />

    <!-- Data access -->
    <PackageVersion Include="Npgsql" Version="10.0.2" />
    <PackageVersion Include="Dapper" Version="2.1.72" />

    <!-- HTTP / Polygon / FRED -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.5" />
    <!-- Phase E: published TreyThomasCodes.Polygon.* 0.9.0 NuGets dropped
         in favour of <ProjectReference> on the polygon-net-client
         submodule (external/polygon-net-client, pinned at 0.10.0 / 614a273).
         Submodule csprojs carry their own Directory.Packages.props for
         their transitive deps (Refit, FluentValidation, NodaTime). -->

    <!-- Alpaca (stock bars). Polygon's plan doesn't include 1-min stock
         bar history older than ~2 years, so stock bars route to Alpaca's
         data API (uncapped history on the paid SIP feed). Options surface
         (NBBO + chains) stays on Polygon. Same SDK + version used by MBD
         to keep cross-repo upgrades trivial. -->
    <PackageVersion Include="Alpaca.Markets" Version="7.2.0" />

    <!-- Microsoft.Extensions -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.5" />

    <!-- Logging / health -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />

    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.4.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="coverlet.collector" Version="8.0.1" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="Testcontainers" Version="4.7.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.7.0" />
  </ItemGroup>
</Project>
